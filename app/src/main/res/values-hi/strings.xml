    <string name="desc_others_income">किसी अन्य स्रोत से प्राप्त अतिरिक्त धन या आय।</string>
    <string name="desc_rod">नींव, बीम और छत की ढलाई के लिए स्टील की छड़ों की लागत।</string>
    <string name="desc_cement">चिनाई और प्लास्टर के काम के लिए सीमेंट की लागत।</string>
    <string name="desc_bricks">दीवारों और फर्श के लिए ईंटों या कंक्रीट ब्लॉकों की लागत।</string>
    <string name="desc_sand">भरने, प्लास्टर या कंक्रीट के लिए उपयोग की जाने वाली रेत की लागत।</string>
    <string name="desc_stone">ढलाई के काम के लिए पत्थर या ईंट के टुकड़ों की लागत।</string>
    <string name="desc_mason">मिस्त्री, सहायकों की मजदूरी या ठेकेदारों को भुगतान।</string>
    <string name="desc_shuttering">कंक्रीट को सहारा देने के लिए लकड़ी/लोहे के फ्रेम का किराया।</string>
